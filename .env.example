# ============================================================
# USDT Price Tracker - Environment Configuration
# ============================================================

# Flask secret key (use a random string in production)
SECRET_KEY=dev-secret-key-change-in-production

# Database type: 'mysql' for production, 'sqlite' for local dev
DB_TYPE=mysql

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_DB=usdt_tracker

# SQLite Configuration (used when DB_TYPE=sqlite)
SQLITE_PATH=usdt_tracker.db

# CoinGecko API (default is fine, free no-key endpoint)
COIN_API_URL=https://api.coingecko.com/api/v3
